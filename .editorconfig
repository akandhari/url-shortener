root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning
# Unused usings fail the build (works together with GenerateDocumentationFile in Directory.Build.props).
dotnet_diagnostic.IDE0005.severity = warning

# Tests only: rule relaxations, each with a reason.
[tests/**.cs]
# Test names use underscores for readability: Method_scenario_expected.
dotnet_diagnostic.CA1707.severity = none
# ConfigureAwait is irrelevant in test code (no synchronization context in xUnit).
dotnet_diagnostic.CA2007.severity = none
